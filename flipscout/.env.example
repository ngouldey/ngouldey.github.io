# Copy to .env for `npm run dev`. On Netlify, set these under
# Project configuration → Environment variables instead (never commit real keys).

# Required
APP_PASSCODE=pick-something-long
ANTHROPIC_API_KEY=

# Recommended: live eBay listings + eBay photo matching (free keys from developer.ebay.com)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional: Google Lens look-alikes through SerpApi
SERPAPI_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-sonnet-5-5
# EBAY_MARKETPLACE=EBAY_US
